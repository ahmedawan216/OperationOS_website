# Public site
NEXT_PUBLIC_SITE_URL=https://operationos.org

# Server-side Supabase configuration used by the feedback API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Private Control Plane founder authentication
CONTROL_PLANE_FOUNDER_ID=YOUR_INTERNAL_FOUNDER_ID
CONTROL_PLANE_FOUNDER_EMAIL=founder@example.com
CONTROL_PLANE_SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
CONTROL_PLANE_ORIGIN=https://control.operationos.org
CONTROL_PLANE_HOST=control.operationos.org
CONTROL_PLANE_DATA_MODE=authoritative
CONTROL_PLANE_TENANT_ID=operationos

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
